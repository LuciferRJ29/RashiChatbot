{
  "name": "RashiChatbot",
  "description": "Advanced AI Chatbot & Userbot with Scraping-Powered Free AI Engine",
  "logo": "https://envs.sh/IL_.jpg",
  "keywords": [
    "Chatbot",
    "Telegram",
    "RashiChatbot",
    "AI",
    "mongodb",
    "python",
    "pyrogram"
  ],
  "buildpacks": [{
    "url": "heroku/python"
  }],
  "repository": "https://github.com/RashiChatbot/RashiChatbot",
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token from @BotFather",
      "required": true,
      "value": ""
    },
    "OWNER_ID": {
      "description": "Your Telegram User ID (Numeric)",
      "required": true,
      "value": ""
    },
    "MONGO_URL": {
      "description": "MongoDB Connection String (from MongoDB Atlas)",
      "required": false,
      "value": ""
    },
    "STRING_SESSION": {
      "description": "Pyrogram String Session for ID-Chatbot / Userbot (Optional)",
      "required": false,
      "value": ""
    },
    "API": {
      "description": "URL to RashiChatbot-API backend (e.g. http://localhost:8000/api/chat?query= or deployed Render/Koyeb URL)",
      "required": false,
      "value": "http://localhost:8000/api/chat?query="
    }
  }
}
